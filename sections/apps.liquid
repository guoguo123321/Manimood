{% liquid
  assign se_stts = section.settings
  assign stt_layout = se_stts.layout
  if stt_layout == blank
    if se_stts.include_margins == false
      assign stt_layout = 't4s-container-fluid'
    else
      assign stt_layout = 't4s-container-wrap'
    endif
  endif
  if stt_layout == 't4s-container-wrap'
    assign html_layout = '<div class="t4s-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
%}
{{ 'section.css' | asset_url | stylesheet_tag }}
{%- if stt_layout == 'custom-container' -%}
<style>
  .{{ section.id }} .custom-container {
    max-width: {{ se_stts.custom_container }};
    margin: 0 auto;
  }
</style>
{%- endif -%}
<div class="{{ section.id }} apps-box t4s-section-inner" {% render 'section_style', se_stts: se_stts %}{% if settings.animations_reveal_on_scroll %} hdt-reveal="fade-in"{% endif %}>
  {{- html_layout[0] -}}
  {%- for block in section.blocks -%}
    {%- render block -%}
  {%- endfor -%}
  {{- html_layout[1] -}}
</div>

{% schema %}
{
  "name": "App",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "layout",
      "default": "t4s-container-wrap",
      "options": [
        {
          "label": "Wrapped container",
          "value": "t4s-container-wrap"
        },
        {
          "label": "Full width",
          "value": "t4s-container-fluid"
        },
        {
          "label": "custom container",
          "value": "custom-container"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_container",
      "label": "custom container",
      "default": "1200px",
      "visible_if": "{{ section.settings.layout == 'custom-container' }}"
    },
    {
      "type": "color",
      "id": "cl_bg",
      "label": "bg_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cl_bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "+ Design pc options"
    },
    {
      "type": "text",
      "id": "mg",
      "label": "Margin",
      "info": "Margin top, margin right, margin bottom, margin left. If you not use to blank",
      "default": "0px,0px,0px,0px"
    },
    {
      "type": "text",
      "id": "pd",
      "label": "Padding",
      "info": "Padding top, padding right, padding bottom, padding left. If you not use to blank",
      "default": "0px,0px,70px,0px"
    },
    {
      "type": "header",
      "content": "+ Design Tablet Options"
    },
    {
      "type": "text",
      "id": "mg_tb",
      "label": "Margin",
      "default": "0px,0px,0px,0px"
    },
    {
      "type": "text",
      "id": "pd_tb",
      "label": "Padding",
      "default": "0px,0px,50px,0px"
    },
    {
      "type": "header",
      "content": "+ Design mobile options"
    },
    {
      "type": "text",
      "id": "mg_mb",
      "label": "Margin",
      "default": "0px,0px,0px,0px"
    },
    {
      "type": "text",
      "id": "pd_mb",
      "label": "Padding",
      "default": "0px,0px,30px,0px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "App"
    }
  ]
}
{% endschema %}
