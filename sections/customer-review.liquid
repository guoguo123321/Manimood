{{ 'section.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}
{{ 'custom-effect.css' | asset_url | stylesheet_tag }}
{%- if se_stts.layout == 'custom-container' -%}
<style>
  .{{ section.id }} .custom-container{
    max-width:{{ se_stts.custom_container }};
    margin: 0 auto;
  }
</style>
{%- endif -%}
<div class="{{ section.id }} customer-review-box t4s-section-inner" {% render 'section_style', se_stts: se_stts -%}>
  {{- html_layout[0] -}}
  {%- render 'section_tophead', se_stts: se_stts -%}
  <div class="customer-review-container show-pagination-pc-{{ se_stts.show_pagination_pc }} show-navigation-pc-{{ se_stts.show_navigation_pc }} show-pagination-mb-{{ se_stts.show_pagination_mb }} show-navigation-mb-{{ se_stts.show_navigation_mb }}" style="--color-arrow:{{ se_stts.color_arrow }};--color-arrow-hover:{{ se_stts.color_arrow_hover }};--col-dk:{{ se_stts.col_dk }};--col-tb:{{ se_stts.col_tb }};--col-mb:{{ se_stts.col_mb }};--space-h:{{ se_stts.space_h_item }}px;--space-h-mb:{{ se_stts.space_h_item_mb }}px;">
    <div class="swiper customerReview">
      <div class="swiper-wrapper">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign bk_stts = block.settings -%}
            {%- liquid
              assign rating = bk_stts.rating | default: 5
              assign review_product = bk_stts.product
              assign product_image = blank
              if review_product != blank
                assign product_image = review_product.featured_media.preview_image | default: review_product.featured_image
              endif
            -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="customer-review-item t4s-eff-img-{{ img_effect }}" timeline hdt-reveal="slide-in" style="--animation-order:{{ forloop.index0 }};">
                <div class="customer-review-image t4s-eff t4s-eff-{{ b_effect }}">
                  {%- if bk_stts.image != blank -%}
                    {%- assign image = bk_stts.image -%}
                    <div class="t4s_ratio t4s_ratio1_1" style="--aspect-ratioapt: {{ image.aspect_ratio | default: 1 }};">
                      {%- assign review_image_alt = bk_stts.image_alt | strip | default: image.alt | default: bk_stts.name -%}
                      {{ image | image_url: width: 1000 | image_tag: class: 't4s-obj-eff', loading: 'lazy', sizes: '(min-width: 1025px) 25vw, (min-width: 768px) 33vw, 75vw', widths: '200,400,600,800,1000', alt: review_image_alt }}
                      <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                    </div>
                  {%- else -%}
                    <div class="t4s_ratio t4s_ratio1_1">
                      {{ 'image' | placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' }}
                    </div>
                  {%- endif -%}
                </div>
                <div class="customer-review-info">
                  <div class="customer-review-stars" aria-label="{{ rating }} star rating">
                    {%- for i in (1..rating) -%}
                      {{ review_star }}
                    {%- endfor -%}
                  </div>
                  {%- if bk_stts.content != blank -%}
                    <p class="customer-review-content">{{ bk_stts.content }}</p>
                  {%- endif -%}
                  {%- if bk_stts.name != blank -%}
                    <div class="customer-review-name">{{ bk_stts.name }}</div>
                  {%- endif -%}
                  {%- if review_product != blank -%}
                    <a class="customer-review-product" href="{{ review_product.url }}">
                      <span class="customer-review-product__img">
                        {%- if product_image != blank -%}
                          <img src="{{ product_image | image_url: width: 60, height: 60, crop: 'center' }}" width="30" height="30" alt="{{ review_product.title | escape }}" loading="lazy">
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 't4s-placeholder-svg' }}
                        {%- endif -%}
                      </span>
                      <span class="customer-review-product__title">{{ review_product.title }}</span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- case forloop.index -%}
              {%- when 1 -%}
                {%- assign review_text = 'The 52-color clay kit saved our rainy weekend! My 6-year-old was completely engaged for 3 hours straight without asking for the iPad.' -%}
                {%- assign review_name = 'Sarah M.' -%}
                {%- assign review_product_title = 'Claylia 52-Color Magic Clay Kit' -%}
              {%- when 2 -%}
                {%- assign review_text = "We made matching mugs as a family. My daughter still uses hers every morning for her 'special milk.' Priceless." -%}
                {%- assign review_name = 'Jessica T.' -%}
                {%- assign review_product_title = 'Claylia Air Dry Pottery Kit' -%}
              {%- when 3 -%}
                {%- assign review_text = "Bought this for my niece's birthday. She made a flower bouquet that looks so real her teacher thought they were from a florist." -%}
                {%- assign review_name = 'Amanda K.' -%}
                {%- assign review_product_title = 'Claylia 52-Color Magic Clay Kit' -%}
              {%- else -%}
                {%- assign review_text = 'Perfect rainy day activity. We made coasters together and now they sit on our coffee table. Conversation starters every time.' -%}
                {%- assign review_name = 'Rachel P.' -%}
                {%- assign review_product_title = 'Claylia Craft Plaster Casting Kit' -%}
            {%- endcase -%}
            <div class="swiper-slide">
              <div class="customer-review-item t4s-eff-img-{{ img_effect }}" timeline hdt-reveal="slide-in" style="--animation-order:{{ forloop.index0 }};">
                <div class="customer-review-image t4s-eff t4s-eff-{{ b_effect }}">
                  <div class="t4s_ratio t4s_ratio1_1">
                    {{ 'image' | placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' }}
                  </div>
                </div>
                <div class="customer-review-info">
                  <div class="customer-review-stars" aria-hidden="true">
                    {%- for s in (1..5) -%}
                      {{ review_star }}
                    {%- endfor -%}
                  </div>
                  <p class="customer-review-content">{{ review_text }}</p>
                  <div class="customer-review-name">{{ review_name }}</div>
                  <div class="customer-review-product">
                    <span class="customer-review-product__img">
                      {{ 'product-1' | placeholder_svg_tag: 't4s-placeholder-svg' }}
                    </span>
                    <span class="customer-review-product__title">{{ review_product_title }}</span>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <div class="common-swiper-media">
      <div class="swiper-pagination common-swiper-pagination customer-review-pagination"></div>
    </div>
    <button type="button" class="swiper-button-prev common-prev customer-review-prev" aria-label="Previous slide">
      {% render 'swiper-nav-icon', direction: 'prev', class: 'customer-review-nav-icon' %}
    </button>
    <button type="button" class="swiper-button-next common-next customer-review-next" aria-label="Next slide">
      {% render 'swiper-nav-icon', direction: 'next', class: 'customer-review-nav-icon' %}
    </button>
  </div>
  {{- html_layout[1] -}}
</div>

<script>
window.ManimoodComponents(document.querySelector('.{{ section.id }}'), function () {
  (function() {
    var el = document.querySelector('.{{ section.id }} .customerReview');
    if (!el || typeof Swiper === 'undefined') return;
    new Swiper(el, {
      slidesPerView: {{ se_stts.col_mb }},
      spaceBetween: {{ se_stts.space_h_item_mb }},
      watchOverflow: true,
      pagination: {
        el: '.{{ section.id }} .customer-review-pagination',
        clickable: true
      },
      navigation: {
        nextEl: '.{{ section.id }} .customer-review-next',
        prevEl: '.{{ section.id }} .customer-review-prev'
      },
      breakpoints: {
        768: {
          slidesPerView: {{ se_stts.col_tb }},
          spaceBetween: {{ se_stts.space_h_item }}
        },
        1025: {
          slidesPerView: {{ se_stts.col_dk }},
          spaceBetween: {{ se_stts.space_h_item }}
        }
      }
    });
  })();

}, true);
</script>
