{% liquid
  assign se_stts = section.settings
  assign stt_layout = se_stts.layout
  assign form_id = 'EmailSubscribe-' | append: section.id
  if stt_layout == 't4s-container-wrap'
    assign html_layout = '<div class="t4s-container">__</div>' | split: '__'
  elsif stt_layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
%}
{{ 'section.css' | asset_url | stylesheet_tag }}
{%- if se_stts.layout == 'custom-container' -%}
<style>
  .{{ section.id }} .custom-container{
    max-width:{{ se_stts.custom_container }};
    margin: 0 auto;
  }
</style>
{%- endif -%}
{%- capture append_style -%}--email-title-cl: {{ se_stts.title_cl }};--email-subtitle-cl: {{ se_stts.subtitle_cl }};{%- endcapture -%}
<div class="{{ section.id }} email-subscribe-box t4s-section-inner" {% render 'section_style', se_stts: se_stts, append_style: append_style -%}>
  {{- html_layout[0] -}}
  {%- render 'section_tophead', se_stts: se_stts -%}
  {%- form 'customer', id: form_id, class: 'email-subscribe-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="email-subscribe-fields">
      <label class="visually-hidden" for="{{ form_id }}-email">{{ se_stts.placeholder | default: 'Enter your email address...' }}</label>
      <input
        id="{{ form_id }}-email"
        class="email-subscribe-input"
        type="email"
        name="contact[email]"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        placeholder="{{ se_stts.placeholder | escape }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        required
        {% if form.errors %}
          aria-invalid="true"
          aria-describedby="{{ form_id }}-error"
        {% elsif form.posted_successfully? %}
          aria-describedby="{{ form_id }}-success"
        {% endif %}
      >
      <button type="submit" class="email-subscribe-btn custom-link" name="commit">
        <span class="email-subscribe-btn__text">{{ se_stts.btn_label }}</span>
      </button>
    </div>
    {%- if form.errors -%}
      <p class="email-subscribe-message email-subscribe-message--error" id="{{ form_id }}-error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    {%- if form.posted_successfully? -%}
      <p class="email-subscribe-message email-subscribe-message--success" id="{{ form_id }}-success" tabindex="-1">{{ 'sections.newsletter_form.confirmation' | t }}</p>
    {%- endif -%}
  {%- endform -%}
  {{- html_layout[1] -}}
</div>
{% schema %}
  {
    "name": "Email Subscribe",
    "class": "shopify-email-subscribe",
    "tag": "section",
    "settings": [
      {"type": "select","id": "layout","label": "layout","default":"t4s-container-wrap",
        "options": [
          {"label":"Wrapped container","value": "t4s-container-wrap"},
          {"label":"Full width","value": "t4s-container-fluid"},
          {"label":"custom container","value": "custom-container"}
        ]
      },
      {"type": "text","id": "custom_container","label": "custom container","default": "1200px","visible_if": "{{ section.settings.layout == 'custom-container' }}"},

      {"type": "header","content": "1. Heading options"},
      {"type": "select","id": "design_heading","label": "+ Design heading","default": "1",
          "options": [
              {"value": "1","label": "Design 01"},
              {"value": "2","label": "Design 02"},
              {"value": "3","label": "Design 03"},
              {"value": "4","label": "Design 04"},
              {"value": "5","label": "Design 05"},
              {"value": "6","label": "Design 06 (width line-awesome)"},
              {"value": "7","label": "Design 07"},
              {"value": "8","label": "Design 08"},
              {"value": "9","label": "Design 09"},
              {"value": "10","label": "Design 10"},
              {"value": "11","label": "Design 11"},
              {"value": "12","label": "Design 12"},
              {"value": "13","label": "Design 13"},
              {"value": "14","label": "Design 14"},
              {"value": "15","label": "Design 15"},
              {"value": "16","label": "Design 16"}
          ]
      },
      {"type": "select","id": "heading_align","label": "+ Heading align","default": "t4s-text-center",
        "options": [
            {"value": "t4s-text-start","label": "Left"},
            {"value": "t4s-text-center","label": "Center"},
            {"value": "t4s-text-end","label": "Right"}
        ]
      },
      {"type": "select","id": "heading_fontf","label": "Font family","default": "4",
        "options": [
          {"label": "Inherit","value": "inherit"},
          {"label": "Font family #1","value": "1"},
          {"label": "Font family #2","value": "2"},
          {"label": "Font family #3","value": "3"},
          {"label": "Font family #4(Butler-Bold)","value": "4"}
        ]
      },
      {"type": "html","id": "top_heading","label": "+ Heading","default": "Join The Manimood Creative Club"},
      {"type": "text","id": "icon_heading","label": "Enter a icon name on heading","info": "Only used for design 6 [LineAwesome]()","default": "las la-gem"},
      {"type": "textarea","id": "top_subheading","label": "+ Subheading","default": "Subscribe for 10% off, once per customer, plus new arrivals. Code delivered by email."},
      {"type": "number","id": "tophead_mb","label": "+ Space bottom (px)","info": "The vertical spacing between heading and content","default": 30},
      {"type": "color","id": "title_cl","label": "Heading color","default": "#FFFFFF"},
      {"type": "color","id": "subtitle_cl","label": "Subheading color","default": "#FFFFFF"},

      {"type": "header","content": "2. Form"},
      {"type": "text","id": "placeholder","label": "Email placeholder","default": "Enter your email address..."},
      {"type": "text","id": "btn_label","label": "Button label","default": "CLAIM 10% OFF"},

      {"type":"color","id":"cl_bg","label":"bg_color","default":"#000000"},
      {"type": "color_background","id": "cl_bg_gradient","label": "Background gradient"},

      {"type": "header","content": "+ Design pc options"},
      {"type": "text","id": "mg","label": "Margin","info":"Margin top, margin right, margin bottom, margin left. If you not use to blank","default": "0px,0px,0px,0px"},
      {"type": "text","id": "pd","label": "Padding","info":"Padding top, padding right, padding bottom, padding left. If you not use to blank","default": "50px,0px,20px,0px"},

      {"type": "header","content": "+ Design Tablet Options"},
      {"type": "text","id": "mg_tb","label": "Margin","default": "0px,0px,0px,0px"},
      {"type": "text","id": "pd_tb","label": "Padding","default": "28px,0px,20px,0px"},

      {"type": "header","content": "+ Design mobile options"},
      {"type": "text","id": "mg_mb","label": "Margin","default": "0px,0px,0px,0px"},
      {"type": "text","id": "pd_mb","label": "Padding","default": "28px,0px,20px,0px"}
    ],
    "presets":[
      {
        "name":"Email Subscribe",
        "category": "LG"
      }
    ]
  }
{% endschema %}
