{%- liquid
  assign se_stts = section.settings
  assign faqs = se_stts.faqs
  if faqs == blank
    assign faqs = product.metafields.custom.faqs.value
  endif
  if se_stts.layout == 't4s-container-wrap'
    assign html_layout = '<div class="t4s-container">__</div>' | split: '__'
  elsif se_stts.layout == 'custom-container'
    assign html_layout = '<div class="custom-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
-%}
{%- if faqs != blank or request.design_mode -%}
  {{ 'section.css' | asset_url | stylesheet_tag }}
  <div class="faqs-box t4s-section-inner" {% render 'section_style', se_stts: se_stts, append_style: '' %}>
    <div class="faqs-layout" style="--custom_container: {{ se_stts.custom_container | escape }};">
      {{- html_layout[0] -}}
      {%- render 'section_tophead', se_stts: se_stts -%}
      <div class="faqs-list">
        {%- for faq in faqs -%}
          {%- liquid
            assign faq_image = faq.image.value
            assign faq_icon = faq.icon.value
            assign faq_title = faq.title.value
            assign faq_content = faq.content.value
          -%}
          {%- if faq_title != blank -%}
            <product-fold class="product-fold faqs-item">
              <details>
                <summary class="product-fold__summary" id="FaqTitle-{{ section.id }}-{{ forloop.index }}">
                  <span class="faqs-question">
                    {%- if faq_image != blank -%}
                      <span class="faqs-media" aria-hidden="true">{{ faq_image | image_url: width: 96 | image_tag: width: 48, height: 48, loading: 'lazy', alt: '' }}</span>
                    {%- elsif faq_icon != blank -%}
                      <span class="faqs-media" aria-hidden="true">{{ faq_icon }}</span>
                    {%- endif -%}
                    <span>{{ faq_title | escape }}</span>
                  </span>
                  <svg class="product-fold__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                </summary>
                <div class="product-fold__panel" role="region" aria-labelledby="FaqTitle-{{ section.id }}-{{ forloop.index }}">
                  <div class="product-fold__content faqs-answer">{{ faq_content | escape | newline_to_br }}</div>
                </div>
              </details>
            </product-fold>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {{- html_layout[1] -}}
    </div>
  </div>
  <script src="{{ 'product-fold.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% schema %}
{
  "name": "Faqs",
  "class": "shopify-faqs",
  "tag": "section",
  "settings": [
