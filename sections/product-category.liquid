{% liquid
    assign se_stts = section.settings
    assign stt_layout = se_stts.layout
    assign b_effect = se_stts.b_effect
    assign img_effect = se_stts.img_effect
    if stt_layout == 't4s-container-wrap'
      assign html_layout = '<div class="t4s-container">__</div>' | split: '__'
    elsif stt_layout == 'custom-container'
      assign html_layout = '<div class="custom-container">__</div>' | split: '__'
    else
      assign html_layout = '__' | split: '__'
    endif
  %}
  {{ 'section.css' | asset_url | stylesheet_tag }}
  {{ 'swiper.css' | asset_url | stylesheet_tag }}
  {{ 'custom-effect.css' | asset_url | stylesheet_tag }}
  {%- if se_stts.layout == 'custom-container' %}
  <style>
    .{{ section.id }} .custom-container{
      max-width:{{ se_stts.custom_container }};
      margin: 0 auto;
    }
  </style>
  {%- endif -%}
  <div class="{{ section.id }} product-category-box t4s-section-inner" {% render 'section_style', se_stts: se_stts -%}>
    {{- html_layout[0] -}}
    {%- render 'section_tophead', se_stts: se_stts -%}
    <div class="product-category-container {{ se_stts.box_align }} show-pagination-pc-{{ se_stts.show_pagination_pc }} show-navigation-pc-{{ se_stts.show_navigation_pc }} show-pagination-mb-{{ se_stts.show_pagination_mb }} show-navigation-mb-{{ se_stts.show_navigation_mb }}" style="--color-arrow:{{ se_stts.color_arrow }};--color-arrow-hover:{{ se_stts.color_arrow_hover }};--title-color:{{ se_stts.title_color }};--subtitle-color:{{ se_stts.subtitle_color }};--col-dk:{{ se_stts.col_dk }};--col-tb:{{ se_stts.col_tb }};--col-mb:{{ se_stts.col_mb }};--space-h:{{ se_stts.space_h_item }}px;--space-h-mb:{{ se_stts.space_h_item_mb }}px;">
      <div class="swiper productCategory">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% assign blo_setts = block.settings %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="product-category-item t4s-eff-img-{{ img_effect }}" timeline hdt-reveal="slide-in" style="background:{{ blo_setts.item_bg }};--item-bdr:{{ se_stts.item_bdr }}px;--animation-order:{{ forloop.index0 }};">
                <div class="product-category-image t4s-eff t4s-eff-{{ b_effect }}">
                  {% if blo_setts.image != blank %}
                    {%- assign image = blo_setts.image -%}
                    <div class="t4s_ratio t4s_ratio4_3">
                      <img {% if image.presentation.focal_point != '50.0% 50.0%' %} style="object-position: {{ image.presentation.focal_point }}"{% endif %} class="lazyloadt4s t4s-lz--fadeIn t4s-obj-eff" data-src="{{ image | image_url: width: 1 }}" data-widths="[100,200,400,600,700,800,900,1000,1200,1400,1600]" data-optimumx="2" data-sizes="auto" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt | default: blo_setts.title | escape }}">
                      <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                    </div>
                  {%- else -%}
                    <div class="t4s_ratio t4s_ratio4_3">
                      {{ 'collection-1' | placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' }}
                    </div>
                  {% endif %}
                </div>
                <div class="product-category-info">
                  {% if blo_setts.title != blank %}
                    <div class="product-category-title">{{ blo_setts.title }}</div>
                  {% endif %}
                  {% if blo_setts.subtitle != blank %}
                    <div class="product-category-subtitle" style="--subtitle-mb:{{ blo_setts.subtitle_mb }}px;--subtitle-mb-mb:{{ blo_setts.subtitle_mb_mb | default: blo_setts.subtitle_mb }}px;--subtitle-mb-nounit:{{ blo_setts.subtitle_mb }};">{{ blo_setts.subtitle }}</div>
                  {% endif %}
                  {% if blo_setts.btn_label != blank %}
                    <a class="product-category-btn common-pill-btn custom-link{% unless blo_setts.btn_link %} is-disabled{% endunless %}" {% if blo_setts.btn_link != blank %}href="{{ blo_setts.btn_link }}"{% endif %} style="--btn-bg:{{ blo_setts.btn_bg }};--btn-bg-hover:{{ blo_setts.btn_bg_hover }};--btn-cl:{{ blo_setts.btn_color }};">
                      <span class="common-pill-btn__text">{{ blo_setts.btn_label }}</span>
                      {% comment %} {% render 'pill-btn-arrow' %} {% endcomment %}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="common-swiper-media">
        <div class="swiper-pagination common-swiper-pagination product-category-pagination"></div>
      </div>
      <button type="button" class="swiper-button-prev common-prev product-category-prev" aria-label="Previous slide">
        {% render 'swiper-nav-icon', direction: 'prev', class: 'product-category-nav-icon' %}
      </button>
      <button type="button" class="swiper-button-next common-next product-category-next" aria-label="Next slide">
        {% render 'swiper-nav-icon', direction: 'next', class: 'product-category-nav-icon' %}
      </button>
    </div>
    {{- html_layout[1] -}}
  </div>
  
  <script>
window.ManimoodComponents(document.querySelector('.{{ section.id }}'), function () {
    (function() {
      var el = document.querySelector('.{{ section.id }} .productCategory');
      if (!el || typeof Swiper === 'undefined') return;
      new Swiper(el, {
        slidesPerView: {{ se_stts.col_mb }},
        spaceBetween: {{ se_stts.space_h_item_mb }},
        watchOverflow: true,
        pagination: {
          el: '.{{ section.id }} .product-category-pagination',
          clickable: true
        },
        navigation: {
          nextEl: '.{{ section.id }} .product-category-next',
          prevEl: '.{{ section.id }} .product-category-prev'
        },
        breakpoints: {
          768: {
            slidesPerView: {{ se_stts.col_tb }},
            spaceBetween: {{ se_stts.space_h_item }}
          },
          1025: {
            slidesPerView: {{ se_stts.col_dk }},
            spaceBetween: {{ se_stts.space_h_item }}
          }
        }
      });
    })();
  
}, true);
</script>
  {% schema %}
    {
      "name": "Product Category",
      "class": "shopify-product-category",
      "tag": "section",
      "settings": [
        {"type": "select","id": "layout","label": "layout","default":"t4s-container-wrap",
          "options": [
            {"label":"Wrapped container","value": "t4s-container-wrap"},
            {"label":"Full width","value": "t4s-container-fluid"},
            {"label":"custom container","value": "custom-container"}
          ]
        },
        {"type": "text","id": "custom_container","label": "custom container","default": "1200px"},
  
        {"type": "select","id": "box_align","label": "+ box align","default": "t4s-text-center",
          "options": [
              {"value": "t4s-text-start","label": "Left"},
              {"value": "t4s-text-center","label": "Center"},
              {"value": "t4s-text-end","label": "Right"}
          ]
        },
  
        {"type": "header","content": "1. Heading options"},
        {"type": "select","id": "design_heading","label": "+ Design heading","default": "1",
            "options": [
                {"value": "1","label": "Design 01"},
                {"value": "2","label": "Design 02"},
                {"value": "3","label": "Design 03"},
                {"value": "4","label": "Design 04"},
                {"value": "5","label": "Design 05"},
                {"value": "6","label": "Design 06 (width line-awesome)"},
                {"value": "7","label": "Design 07"},
                {"value": "8","label": "Design 08"},
                {"value": "9","label": "Design 09"},
                {"value": "10","label": "Design 10"},
                {"value": "11","label": "Design 11"},
                {"value": "12","label": "Design 12"},
                {"value": "13","label": "Design 13"},
                {"value": "14","label": "Design 14"},
                {"value": "15","label": "Design 15"},
                {"value": "16","label": "Design 16"}
            ]
        },
        {"type": "select","id": "heading_align","label": "+ Heading align","default": "t4s-text-start",
          "options": [
              {"value": "t4s-text-start","label": "Left"},
              {"value": "t4s-text-center","label": "Center"},
              {"value": "t4s-text-end","label": "Right"}
          ]
        },
        {"type": "select","id": "heading_fontf","label": "Font family","default": "inherit",
          "options": [
            {"label": "Inherit","value": "inherit"},
            {"label": "Font family #1","value": "1"},
            {"label": "Font family #2","value": "2"},
            {"label": "Font family #3","value": "3"}
          ]
        },
        {"type": "html","id": "top_heading","label": "+ Heading","default": "How Do You Want to Create Today?"},
        {"type": "text","id": "icon_heading","label": "Enter a icon name on heading","info": "Only used for design 6 [LineAwesome]()","default": "las la-gem"},
        {"type": "textarea","id": "top_subheading","label": "+ Subheading","default": "Explore kits designed for every kind of creative moment."},
        {"type": "number","id": "tophead_mb","label": "+ Space bottom (px)","info": "The vertical spacing between heading and content","default": 30},
  
        {"type": "header","content": "+ Heading button"},
        {"type": "text","id": "head_btn_label","label": "Button label","default": "View All"},
        {"type": "url","id": "head_btn_url","label": "Button link"},
        {"type": "checkbox","id": "head_btn_icon","label": "Enable button icon","default": false},
        {"type": "select","id": "head_btn_style","label": "Button style","default": "link",
          "options": [
            {"label": "Default","value": "default"},
            {"label": "Outline","value": "outline"},
            {"label": "Bordered bottom","value": "bordered"},
            {"label": "Link","value": "link"}
          ]
        },
        {"type": "select","id": "head_btn_size","label": "Button size","default": "medium",
          "options": [
            {"label": "Small","value": "small"},
            {"label": "Medium","value": "medium"},
            {"label": "Large","value": "large"}
          ]
        },
        {"type": "select","id": "head_btn_cl","label": "Button color","default": "dark",
          "options": [
            {"value": "light","label": "Light"},
            {"value": "dark","label": "Dark"},
            {"value": "primary","label": "Primary"},
            {"value": "custom1","label": "Custom color 1"},
            {"value": "custom2","label": "Custom color 2"}
          ]
        },
        {"type": "select","id": "head_btn_effect","label": "Button hover effect","default": "default","info": "Only working button style default, outline",
          "options": [
            {"label": "Default","value": "default"},
            {"label": "Fade","value": "fade"},
            {"label": "Rectangle out","value": "rectangle-out"},
            {"label": "Sweep to right","value": "sweep-to-right"},
            {"label": "Sweep to left","value": "sweep-to-left"},
            {"label": "Sweep to bottom","value": "sweep-to-bottom"},
            {"label": "Sweep to top","value": "sweep-to-top"},
            {"label": "Shutter out horizontal","value": "shutter-out-horizontal"},
            {"label": "Outline","value": "outline"},
            {"label": "Shadow","value": "shadow"}
          ]
        },
        {"type": "checkbox","id": "head_btn_hidden_mb","label": "Hidden head button on Mobile","default": false},
  
        {"type": "header","content": "2. Items options"},
        {"type": "range","id": "item_bdr","label": "Border radius","default": 4,"min": 0,"max": 50,"step": 1,"unit": "px"},
        {"type": "color","id": "title_color","label": "Title color","default": "#171932"},
        {"type": "color","id": "subtitle_color","label": "Subtitle color","default": "#36384C"},
        {"type": "select","id": "col_dk","label": "Items per row","default": "4",
          "options": [
            {"value": "1","label": "1"},
            {"value": "2","label": "2"},
            {"value": "3","label": "3"},
            {"value": "4","label": "4"},
            {"value": "5","label": "5"},
            {"value": "6","label": "6"},
            {"value": "7","label": "7"},
            {"value": "8","label": "8"},
            {"value": "9","label": "9"},
            {"value": "10","label": "10"}
          ]
        },
        {"type": "select","id": "col_tb","label": "Items per row (Tablet)","default": "2",
          "options": [
            {"value": "1","label": "1"},
            {"value": "2","label": "2"},
            {"value": "3","label": "3"},
            {"value": "4","label": "4"},
            {"value": "5","label": "5"},
            {"value": "6","label": "6"}
          ]
        },
        {"type": "select","id": "col_mb","label": "Items per row (Mobile)","default": "2",
          "options": [
            {"value": "1","label": "1"},
            {"value": "2","label": "2"},
            {"value": "3","label": "3"},
            {"value": "4","label": "4"}
          ]
        },
        {"type": "range","id": "space_h_item","label": "Horizontal space between items","min": 0,"max": 50,"step": 1,"unit": "px","default": 30},
        {"type": "range","id": "space_h_item_mb","label": "Horizontal space between items (Mobile)","min": 0,"max": 50,"step": 1,"unit": "px","default": 10},
        {"type": "select","id": "img_effect","label": "Image hover effect","info": "Waring: Hovering effect will resize your images","default": "none",
          "options": [
            {"value": "none","label": "None"},
            {"value": "zoom","label": "Zoom in"},
            {"value": "rotate","label": "Rotate"},
            {"value": "translateToTop","label": "Move to top"},
            {"value": "translateToRight","label": "Move to right"},
            {"value": "translateToBottom","label": "Move to bottom"},
            {"value": "translateToLeft","label": "Move to left"},
            {"value": "filter","label": "Filter"},
            {"value": "bounceIn","label": "BounceIn"}
          ]
        },
        {"type": "select","id": "b_effect","label": "Banner effect when hover","default": "none",
          "options": [
            {"value": "none","label": "None"},
            {"value": "border-run","label": "Border run"},
            {"value": "pervasive-circle","label": "Pervasive circle"},
            {"value": "plus-zoom-overlay","label": "Plus zoom overlay"},
            {"value": "dark-overlay","label": "Dark overlay"},
            {"value": "light-overlay","label": "Light overlay"}
          ]
        },
  
        {"type": "header","content": "Swiper controls"},
        {"type": "checkbox","id": "show_pagination_pc","label": "Show pagination (PC)","default": false},
        {"type": "checkbox","id": "show_navigation_pc","label": "Show navigation arrows (PC)","default": false},
        {"type": "checkbox","id": "show_pagination_mb","label": "Show pagination (Mobile)","default": false},
        {"type": "checkbox","id": "show_navigation_mb","label": "Show navigation arrows (Mobile)","default": false},
        {"type": "color","id": "color_arrow","label": "Navigation arrow color","default": "#171932"},
        {"type": "color","id": "color_arrow_hover","label": "Navigation arrow hover color","default": "#00ADEF"},
  
        {"type":"color","id":"cl_bg","label":"bg_color","default":"#F4F5F7"},
        {"type": "color_background","id": "cl_bg_gradient","label": "Background gradient"},
      
        {"type": "header","content": "+ Design pc options"},
        {"type": "text","id": "mg","label": "Margin","info":"Margin top, margin right, margin bottom, margin left. If you not use to blank","default": "0px,0px,0px,0px"},
        {"type": "text","id": "pd","label": "Padding","info":"Padding top, padding right, padding bottom, padding left. If you not use to blank","default": "0px,0px,0px,0px"},
      
        {"type": "header","content": "+ Design Tablet Options"},
        {"type": "text","id": "mg_tb","label": "Margin","default": "0px,0px,0px,0px"},
        {"type": "text","id": "pd_tb","label": "Padding","default": "0px,0px,0px,0px"},
      
        {"type": "header","content": "+ Design mobile options"},
        {"type": "text","id": "mg_mb","label": "Margin","default": "0px,0px,0px,0px"},
        {"type": "text","id": "pd_mb","label": "Padding","default": "0px,0px,0px,0px"}
      ],
      "blocks":[
        {
          "type": "item",
          "name": "item",
          "settings": [
            {"type": "image_picker","id": "image","label": "Image"},
            {"type": "color","id": "item_bg","label": "Background","default": "#E8F6FC"},
            {"type": "text","id": "title","label": "Title","default": "Kids Magic Clay"},
            {"type": "textarea","id": "subtitle","label": "Subtitle","default": "36 & 52 vibrant colors for focus & fine motor skills."},
            {"type": "number","id": "subtitle_mb","label": "Subtitle space bottom (px)","default": 38},
            {"type": "number","id": "subtitle_mb_mb","label": "Subtitle space bottom (Mobile) (px)","default": 38},
            {"type": "text","id": "btn_label","label": "Button label","default": "Shop Magic Clay"},
            {"type": "url","id": "btn_link","label": "Button link"},
            {"type": "color","id": "btn_bg","label": "Button background","default": "#00ADEF"},
            {"type": "color","id": "btn_bg_hover","label": "Button background hover","default": "#000000"},
            {"type": "color","id": "btn_color","label": "Button text color","default": "#E6BA8C"}
          ]
        }
      ],
      "presets":[
        {
          "name":"Product Category",
          "category": "LG",
          "blocks": [
            {
              "type": "item",
              "settings": {
                "item_bg": "#E8F6FC",
                "title": "Kids Magic Clay",
                "subtitle": "36 & 52 vibrant colors for focus & fine motor skills.",
                "btn_label": "Shop Magic Clay"
              }
            },
            {
              "type": "item",
              "settings": {
                "item_bg": "#E8F6FC",
                "title": "DIY Clay Kit",
                "subtitle": "Cut, shape and create with soft non-toxic clay sheets.",
                "btn_label": "Shop Clay Kit"
              }
            },
            {
              "type": "item",
              "settings": {
                "item_bg": "#E8F6FC",
                "title": "Plaster Craft Kit",
                "subtitle": "Make keepsake dishes and candle holders at home.",
                "btn_label": "Shop Plaster Kit"
              }
            }
          ]
        }
      ]
    }
  {% endschema %}
  