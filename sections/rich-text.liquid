        {"type": "range","id": "button_mh_mb","label": "Min height (Mobile)","min": 10,"max": 50,"step": 1,"unit": "px","default": 40,"info": "Only working button style default, outline"},
        {"type": "range","id": "button_pd_lr_mb","label": "Padding left/right (Mobile)","min": 0,"max": 100,"step": 1,"unit": "px","default": 20,"info": "Only working button style default, outline"},
        {"type": "range","id": "button_ls_mb","label": "Letter spacing (Mobile)","min": 0,"max": 10,"step": 0.1,"unit": "px","default": 0},
        {"type": "number","id": "button_mgb_mb","label": "Margin bottom (Mobile)","default": 0},
        {"type": "number","id": "button_mgr_mb","label": "Margin right (Mobile)","default": 0,"info": "Distance to the button on the right on mobile"},

        {"type": "header","content": "+ Design pc options"},
        {"type": "range","id": "space_top","min": 0,"max": 100,"step": 1,"label": "Space top","unit": "px","default": 0},
        {"type": "range","id": "space_bottom","min": 0,"max": 100,"step": 1,"label": "Space bottom","unit": "px","default": 0},

        {"type": "header","content": "+ Design mobile options"},
        {"type": "range","id": "space_top_mb","min": 0,"max": 100,"step": 1,"label": "Space top","unit": "px","default": 0},
        {"type": "range","id": "space_bottom_mb","min": 0,"max": 100,"step": 1,"label": "Space bottom","unit": "px","default": 0}
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_child",
          "label": "Image"
        },
        {
          "type": "number",
          "id": "img_width",
          "label": "Image width (Unit: px)",
          "info": "Set 0 to use width default of image",
          "default": 637
        },
        {
          "type": "number",
          "id": "img_width_mb",
          "label": "Image width on mobile (Unit: px)",
          "info": "Set 0 to use width default of image",
          "default": 345
        },
        {
          "type": "checkbox",
          "id": "hidden_mobile",
          "label": "Hidden on mobile",
          "default": false
        },
        {
          "type": "header",
          "content": "+ Design pc options"
        },
        {
          "type": "range",
          "id": "space_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "label": "Space top",
          "unit": "px",
          "default": 0
        },
        {
          "type": "number",
          "id": "mgb",
          "label": "Space bottom",
          "default": 20
        },
        {
          "type": "header",
          "content": "+ Design mobile options"
        },
        {
          "type": "range",
          "id": "space_top_mb",
          "min": 0,
          "max": 100,
          "step": 1,
          "label": "Space top",
          "unit": "px",
          "default": 0
        },
        {
          "type": "number",
          "id": "mgb_mb",
          "label": "Space bottom",
          "default": 20
        },
        {
          "type": "paragraph",
          "content": "————————————————"
        },
        {
          "type": "select",
          "id": "animation",
          "label": "Animation",
          "default": "none",
          "options": [
            {"label": "None","value": "none"},
            {"label": "fadeIn","value": "fadeIn"},
            {"label": "fadeInDown","value": "fadeInDown"},
            {"label": "fadeInDownBig","value": "fadeInDownBig"},
            {"label": "fadeInLeft","value": "fadeInLeft"},
