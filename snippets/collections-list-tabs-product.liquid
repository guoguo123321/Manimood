{%- comment -%}
  Product card for collections-list-tabs
  params: product, img_effect, b_effect, is_placeholder, animation_order, extra_class
{%- endcomment -%}
{%- liquid
  assign animation_order = animation_order | default: 0
  assign extra_class = extra_class | default: ''
  if is_placeholder
    assign pr_url = blank
    assign image = blank
    assign image2 = blank
  else
    assign pr_url = product.url
    assign image = product.featured_media.preview_image | default: product.featured_image
    assign image2 = product.images[1]
    assign pr_labels = product.metafields.custom.label.value
  endif
-%}
<div class="collections-list-tabs-item t4s-eff-img-{{ img_effect }}{{ extra_class }}" timeline hdt-reveal="slide-in" style="--animation-order:{{ animation_order }};">
  {%- if is_placeholder -%}
    <div class="collections-list-tabs-image t4s-eff t4s-eff-{{ b_effect }}">
      <div class="t4s_ratio t4s_ratio1_1">
        {{ 'product-1' | placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' }}
      </div>
    </div>
    <div class="collections-list-tabs-info">
      <a class="collections-list-tabs-title" role="link" aria-disabled="true">Product title</a>
      <div class="collections-list-tabs-price">
        <span class="collections-list-tabs-price__placeholder">$26.99</span>
      </div>
    </div>
  {%- else -%}
    <a class="collections-list-tabs-image t4s-eff t4s-eff-{{ b_effect }}{% if image2 != blank %} has-hover-img{% endif %}" href="{{ pr_url }}">
      {%- if image != blank -%}
        <div class="t4s_ratio t4s_ratio1_1" style="--aspect-ratioapt: {{ image.aspect_ratio | default: 1 }};">
          <img {% if image.presentation.focal_point != '50.0% 50.0%' %} style="object-position: {{ image.presentation.focal_point }}"{% endif %} class="collections-list-tabs-img collections-list-tabs-img--main lazyloadt4s t4s-lz--fadeIn t4s-obj-eff" data-src="{{ image | image_url: width: 1 }}" data-widths="[100,200,400,600,700,800,900,1000]" data-optimumx="2" data-sizes="auto" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt | default: product.title | escape }}">
          <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
          {%- if image2 != blank -%}
            <img {% if image2.presentation.focal_point != '50.0% 50.0%' %} style="object-position: {{ image2.presentation.focal_point }}"{% endif %} class="collections-list-tabs-img collections-list-tabs-img--hover lazyloadt4s t4s-lz--fadeIn t4s-obj-eff" data-src="{{ image2 | image_url: width: 1 }}" data-widths="[100,200,400,600,700,800,900,1000]" data-optimumx="2" data-sizes="auto" src="{% render 'img_svg', w: image2.width, h: image2.height %}" width="{{ image2.width }}" height="{{ image2.height }}" alt="{{ image2.alt | default: product.title | escape }}">
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="t4s_ratio t4s_ratio1_1">
          {{ 'product-1' | placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' }}
        </div>
      {%- endif -%}
      {%- if pr_labels != blank or product.available == false -%}
        <span class="collections-list-tabs-badges">
          {%- for pr_label in pr_labels -%}
            {%- assign pr_label_text = pr_label | strip -%}
            {%- if pr_label_text != blank -%}
              <span class="collections-list-tabs-badge">{{ pr_label_text | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- unless product.available -%}
            <span class="collections-list-tabs-badge">{{ 'products.badge.sold_out' | t }}</span>
          {%- endunless -%}
        </span>
      {%- endif -%}
    </a>
    <div class="collections-list-tabs-info">
      {%- if settings.enable_rating -%}
      <div class="collections-list-tabs-rating">
        <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
          {{- product.metafields.judgeme.badge -}}
        </div>
      </div>
      {%- endif -%}
      <a class="collections-list-tabs-title" href="{{ pr_url }}">{{ product.title }}</a>
      <div class="collections-list-tabs-price">
        {%- render 'product-price', product: product -%}
      </div>
    </div>
  {%- endif -%}
</div>
