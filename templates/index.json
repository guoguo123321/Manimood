    "customer_review_yit6wM": {
      "type": "customer-review",
      "blocks": {
        "review_ekwPdY": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/3DA195-MY01-YMX_MH-3_14.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "They are so good, this looks like acrylic. So shiny and they are the best press on nails i ever used",
            "name": "Sarah M.",
            "product": "3d-gold-tail-red-cat-eye-short-almond-press-on-nails"
          }
        },
        "review_BjxcPi": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/A445-MY01-YMX_MH-5_11.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "These press-on nails look just like a salon manicure—clean, stylish, and easy to apply.",
            "name": "Jessica T.",
            "product": "nude-cat-eye-short-square-press-on-nails"
          }
        },
        "review_VzMYaW": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/A392-MY01-YMX_MH-5_11.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "The durability is impressive because they stay in place without lifting. I use their glue and they last me over two weeks. The overall look is clean and polished, almost like a salon set. These are a great buy and I plan to order more.",
            "name": "schranz",
            "product": "bright-red-cat-eye-short-square-press-on-nails"
          }
        },
        "review_nihTMq": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/XNQC161_MH-5_12.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "The color stays bright and never fades, even after wearing them for a long time. The size and shape work well and look natural once they are on. They are easy to apply and the texture feels smooth and high quality.",
            "name": "Shanae",
            "product": "chrome-cat-eye-short-square-press-on-nails"
          }
        },
        "review_UXaRNw": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/XNQC129_MH-3_12.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "So cute, they had all of the sizes I needed and the subtle magnetic effect is so pretty. Easy to put on and stayed on well.",
            "name": "Grace P",
            "product": "brown-ombre-chrome-short-almond-press-on-nails"
          }
        },
        "review_hCfW6W": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/XNQC122_MH-5_12.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "I have to say I’m very impressed with these nails. I’m really tough on my hands so every other press-ons I’ve tried break off and crack at the tips within days, but these have been on for 10 days now and are holding solid.",
            "name": "noemi",
            "product": "light-pink-chrome-short-square-press-on-nails"
          }
        },
        "review_WzWATD": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/XNFS124_MH-5_12.jpg",
            "image_alt": "",
            "rating": 5,
            "content": "Looks much better than I thought. Like i got a salon manicure. Thick and strong nails that don't show my nails underneath. Very satisfied. These will last weeks with beauty secrets nail glue.",
            "name": "VS EM",
            "product": "white-french-tip-short-square-press-on-nails"
          }
        }
      },
